# Copy this file to .env.local and fill in your own keys.
# .env.local is git-ignored, so keys are never committed. See README.md.

# Data sources
GFW_API_KEY=
NASA_FIRMS_MAP_KEY=
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
GEMINI_API_KEY=

# Security
ADMIN_KEY=
ACOUSTIC_DEVICE_KEY=
CRON_SECRET=

# Database (Supabase Postgres); production needs the CA certificate
DATABASE_URL=
DATABASE_CA_CERT_PATH=
# or paste the certificate itself:
DATABASE_CA_CERT=

# Telegram alerts and bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Email alerts (Brevo)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# SMS alerts (Africa's Talking)
AT_USERNAME=
AT_API_KEY=
ALERT_SMS_TO=

# Optional switches
ALERT_DEMO_MODE=0
FIRE_ALERT_SCHEDULE=
TELEGRAM_POLLING=
