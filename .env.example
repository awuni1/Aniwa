# Copy this file to .env.local and fill in your own keys.
# .env.local is git-ignored, so keys are never committed.

# Global Forest Watch Data API: tree-cover loss, 2000 baseline, clearing alerts.
# Free at https://data-api.globalforestwatch.org (allow the domain "localhost").
GFW_API_KEY=

# NASA FIRMS: active fires. Free at https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY=

# Optional: send as the x-admin-key header to force /api/region-loss?refresh=1
ADMIN_KEY=
